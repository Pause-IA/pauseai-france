{
	"type": "module",
	"name": "pause-ai",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"dev:watch": "svelte-kit sync && concurrently --names \"VITEST,SVELTE-CHECK,SERVER\" --prefix-colors \"bgMagenta.bold,bgCyan.bold,bgGreen.bold\" \"vitest\" \"svelte-check --tsconfig ./tsconfig.json --watch\" \"vite dev\"",
		"build": "vite build",
		"build:dev": "vite build --mode development",
		"preview": "vite preview",
		"check": "vitest --run && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "concurrently --names \"VITEST,SVELTE-CHECK\" \"vitest\" \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch\"",
		"lint": "stylelint \"src/**/*.{css,svelte}\" && prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "svelte-kit sync && husky",
		"test": "vitest --run",
		"optimize-images": "node scripts/optimize-images.js",
		"generate-elus": "node scripts/generate-elus.js",
		"plan-du-site": "node scripts/plan-du-site.mjs",
